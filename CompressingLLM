    random.seed(s); np.random.seed(s); torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\nSEED = 0\nseed_all(SEED)\ndevice = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nOUT = \"/kaggle/working\"\nprint(\"device:\", device, \"| torch:\", torch.__version__)\n\nmean, std = (0.4914, 0.4822, 0.4465), (0.2470, 0.2435, 0.2616)\ntrain_tf = T.Compose([T.RandomCrop(32, padding=4), T.RandomHorizontalFlip(),\n                      T.ToTensor(), T.Normalize(mean, std)])\neval_tf  = T.Compose([T.ToTensor(), T.Normalize(mean, std)])\n\nds_train_aug  = torchvision.datasets.CIFAR10(\"./data\", train=True,  download=True, transform=train_tf)\nds_train_eval = torchvision.datasets.CIFAR10(\"./data\", train=True,  download=True, transform=eval_tf)\ntest_set      = torchvision.datasets.CIFAR10(\"./data\", train=False, download=True, transform=eval_tf)\n\n# Fixed split, identical for every seed and experiment\nperm = np.random.RandomState(1234).permutation(50000)\ntrain_set = Subset(ds_train_aug,  perm[:45000])\nval_set   = Subset(ds_train_eval, perm[45000:])   # no augmentation\n\nkw = dict(num_workers=2, pin_memory=True)\ntrain_loader = DataLoader(train_set, batch_size=256, shuffle=True,  drop_last=True, **kw)\nval_loader   = DataLoader(val_set,   batch_size=500, shuffle=False, **kw)\ntest_loader  = DataLoader(test_set,  batch_size=500, shuffle=False, **kw)\nprint(len(train_set), len(val_set), len(test_set))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-28T22:37:54.748902Z","iopub.execute_input":"2026-10-28T22:37:54.749475Z","iopub.status.idle":"2026-10-28T22:37:57.261315Z","shell.execute_reply.started":"2026-10-28T22:37:54.749447Z","shell.execute_reply":"2026-10-28T22:37:57.260695Z"}},"outputs":[{"name":"stdout","text":"device: cuda | torch: 2.11.0+cu128\n45000 5000 10000\n","output_type":"stream"}],"execution_count":25},{"cell_type":"markdown","source":"****Cell 2: Model, train and eval functions****","metadata":{}},{"cell_type":"code","source":"def make_model():\n    m = torchvision.models.resnet18(num_classes=10)\n    m.conv1 = nn.Conv2d(3, 64, 3, 1, 1, bias=False)  # CIFAR stem\n    m.maxpool = nn.Identity()\n    return m.to(device)\n\n@torch.no_grad()\ndef evaluate(model, loader):\n    model.eval()\n    correct = total = 0; loss_sum = 0.0\n    for x, y in loader:\n        x, y = x.to(device), y.to(device)\n        out = model(x)\n        loss_sum += F.cross_entropy(out, y, reduction=\"sum\").item()\n        correct += (out.argmax(1) == y).sum().item(); total += y.numel()\n    return correct / total, loss_sum / total\n\ndef train(model, epochs=20, lr=0.1, wd=5e-4):\n    opt = torch.optim.SGD(model.parameters(), lr=lr, momentum=0.9,\n                          weight_decay=wd, nesterov=True)\n    sched = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=lr, epochs=epochs,\n                                                steps_per_epoch=len(train_loader))\n    scaler = torch.amp.GradScaler(\"cuda\")\n    for ep in range(epochs):\n        model.train(); t0 = time.time()\n        for x, y in train_loader:\n            x, y = x.to(device, non_blocking=True), y.to(device, non_blocking=True)\n            opt.zero_grad(set_to_none=True)\n            with torch.autocast(\"cuda\", dtype=torch.float16):\n                loss = F.cross_entropy(model(x), y)\n            scaler.scale(loss).backward(); scaler.step(opt); scaler.update(); sched.step()\n        va, vl = evaluate(model, val_loader)\n        print(f\"ep {ep+1:02d}/{epochs} | train-loss {loss.item():.3f} | val-acc {va:.4f} | {time.time()-t0:.0f}s\")\n    return model","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-28T22:38:02.029018Z","iopub.execute_input":"2026-10-28T22:38:02.029511Z","iopub.status.idle":"2026-10-28T22:38:02.039308Z","shell.execute_reply.started":"2026-10-28T22:38:02.029475Z","shell.execute_reply":"2026-10-28T22:38:02.038604Z"}},"outputs":[],"execution_count":27},{"cell_type":"markdown","source":"\n**Cell 3: Size measurement and logging**","metadata":{}},{"cell_type":"code","source":"def count_params(model):\n    total = sum(p.numel() for p in model.parameters())\n    prunable = sum(p.numel() for p in model.parameters() if p.dim() > 1)  # conv + linear weights\n    return total, prunable\n\ndef size_report(model):\n    buf = io.BytesIO()\n    torch.save({k: v.cpu() for k, v in model.state_dict().items()}, buf)\n    raw = buf.getbuffer().nbytes\n    comp = len(zlib.compress(buf.getvalue(), 9))\n    return raw, comp\n\nRESULTS = f\"{OUT}/results.csv\"\ndef log_result(**row):\n    df = pd.DataFrame([row])\n    df.to_csv(RESULTS, mode=\"a\", header=not os.path.exists(RESULTS), index=False)\n    print(row)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-28T22:38:40.774947Z","iopub.execute_input":"2026-10-28T22:38:40.775387Z","iopub.status.idle":"2026-10-28T22:38:40.782303Z","shell.execute_reply.started":"2026-10-28T22:38:40.775322Z","shell.execute_reply":"2026-10-28T22:38:40.78152Z"}},"outputs":[],"execution_count":28},{"cell_type":"markdown","source":"**Cell 4: Train baseline and record numbers**","metadata":{}},{"cell_type":"code","source":"seed_all(SEED)\nmodel = make_model()\nmodel = train(model, epochs=20)\n\ntorch.save(model.state_dict(), f\"{OUT}/baseline_seed{SEED}.pt\")\n\nval_acc,  _ = evaluate(model, val_loader)\ntest_acc, _ = evaluate(model, test_loader)\ntotal, prunable = count_params(model)\nraw, comp = size_report(model)\n\nlog_result(stage=\"baseline\", method=\"none\", seed=SEED, sparsity=0.0, bits=32,\n           val_acc=val_acc, test_acc=test_acc,\n           params=total, prunable=prunable, raw_bytes=raw, zlib_bytes=comp)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-28T22:39:12.194226Z","iopub.execute_input":"2026-10-28T22:39:12.194649Z","iopub.status.idle":"2026-10-28T22:45:20.017892Z","shell.execute_reply.started":"2026-10-28T22:39:12.194621Z","shell.execute_reply":"2026-10-28T22:45:20.017048Z"}},"outputs":[{"name":"stdout