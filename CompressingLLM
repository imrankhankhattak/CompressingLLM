n\ndef build_canvas(model, clip_pct=99.9, width=4608, sep=2):\n    blocks, layout, y = [], [], 0\n    for n, p in prunable_layers(model).items():\n        q, s = quantize_sym(p, clip_pct)\n        m2 = q.reshape(q.shape[0], -1).numpy()          # (out_channels, in*k*k)\n        h, w = m2.shape\n        blk = np.zeros((h + sep, width), np.uint8)      # 0 = padding\n        blk[:h, :w] = m2\n        blocks.append(blk)\n        layout.append(dict(name=n, shape=list(p.shape), y0=y, y1=y+h, w=w, scale=s))\n        y += h + sep\n    return np.concatenate(blocks, 0), layout\n\ncanvas, layout = build_canvas(model, clip_pct=99.9)\nprint(\"canvas:\", canvas.shape, \"| pixels:\", canvas.size, \"| weights:\", sum(l['y1']-l['y0'] for l in layout))\n\nfrom PIL import Image\nImage.fromarray(canvas).save(f\"{OUT}/weights_baseline.png\")\njson.dump(layout, open(f\"{OUT}/weights_layout.json\", \"w\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-28T23:13:41.329987Z","iopub.execute_input":"2026-10-28T23:13:41.330628Z","iopub.status.idle":"2026-10-28T23:13:42.491786Z","shell.execute_reply.started":"2026-10-28T23:13:41.330593Z","shell.execute_reply":"2026-10-28T23:13:42.490976Z"}},"outputs":[{"name":"stdout","text":"canvas: (4852, 4608) | pixels: 22358016 | weights: 4810\n","output_type":"stream"}],"execution_count":30},{"cell_type":"code","source":"fig, ax = plt.subplots(1, 3, figsize=(20, 7))\nax[0].imshow(canvas, cmap=\"gray\", interpolation=\"nearest\", aspect=\"auto\")\nax[0].set_title(\"Whole model (top = early layers)\")\n\nL = {l['name']: l for l in layout}\nfor a, name in zip(ax[1:], [\"layer1.0.conv1.weight\", \"layer4.1.conv2.weight\"]):\n    l = L[name]\n    a.imshow(canvas[l['y0']:l['y1'], :l['w']][:128, :512], cmap=\"gray\", interpolation=\"nearest\", aspect=\"auto\")\n    a.set_title(f\"{name} (top-left 128x512 crop)\")\nplt.tight_layout(); plt.savefig(f\"{OUT}/fig_weights.png\", dpi=100); plt.show()\n\n# Per-layer stats\nrows = []\nfor n, p in pr